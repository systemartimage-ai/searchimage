# Front-end (Vite expõe ao navegador tudo que começa com VITE_).
# A anon key do Supabase é pública por design — a segurança real vem das RLS policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Somente back-end / indexador / Edge Functions ---
# NUNCA prefixar com VITE_. Nunca importar estas variáveis em código que roda no navegador.
SUPABASE_SERVICE_ROLE_KEY=
EMBEDDING_PROVIDER_API_KEY=
